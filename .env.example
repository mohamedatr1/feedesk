# FeeDesk local environment template
# Copy to .env.local and replace the placeholder values. Never commit .env.local.

DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:55432/feedesk
APP_ENV=development
SESSION_SECRET=replace-with-a-long-random-value
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
UPLOAD_DIR=./.local/uploads
LOG_LEVEL=INFO

COOKIE_NAME=fd_session
COOKIE_SECURE=false

RASEL_API_KEY=
RASEL_BASE_URL=https://raselsms.com
RASEL_CHANNEL=local_sms
RASEL_SENDER_ID=
RASEL_TEST_RECIPIENTS=

# Fernet key used to encrypt provider credentials at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_CREDENTIAL_KEY=

# Messaging safety defaults: fake provider, no sends until explicitly enabled.
MESSAGING_PROVIDER=fake
MESSAGING_ENABLED=false
MESSAGING_KILL_SWITCH=true
MESSAGING_RATE_LIMIT_PER_SECOND=1
MESSAGING_MAX_ATTEMPTS=3
MESSAGING_LEASE_SECONDS=60
MESSAGING_ALLOWLIST=
FAKE_PROVIDER_SCENARIO=delivered
# Refuse fake delivery in production unless explicitly overridden; never use
# this override for live delivery.
MESSAGING_ALLOW_FAKE_IN_PRODUCTION=false

# Assisted OCR for scanned PDFs (local Tesseract; requires the Arabic
# traineddata and configs in OCR_TESSDATA_DIR). OCR rows always require review.
OCR_ENABLED=true
OCR_TESSERACT_CMD=tesseract
OCR_TESSDATA_DIR=
OCR_LANGUAGES=ara+eng
OCR_RENDER_DPI=300
OCR_MIN_CONFIDENCE=50

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=replace-with-a-temporary-password
SEED_SCHOOL_NAME=مدرسة الروض الخاصة
SEED_CURRENCY=SYP
SEED_CURRENCY_SYMBOL=د.س
