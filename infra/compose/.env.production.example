# FeeDesk production-like environment template.
#
# Copy to infra/compose/.env.production and replace every value marked
# "replace-me". Never commit the real file. This template contains no real
# credentials and no live provider key.
#
# Generate secrets, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# DATABASE_URL is assembled in docker-compose.prod.yml. If POSTGRES_PASSWORD
# contains URL-reserved characters, percent-encode it first or use a
# long URL-safe value.

# --- Required ---------------------------------------------------------------
POSTGRES_PASSWORD=replace-me-with-a-long-url-safe-value
SESSION_SECRET=replace-me-with-at-least-32-random-characters
# Fernet key used to encrypt the provider credential vault. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PROVIDER_CREDENTIAL_KEY=replace-me-with-a-generated-fernet-key
SEED_ADMIN_PASSWORD=replace-me-with-a-temporary-first-login-password
APP_DOMAIN=feedesk.example.org
SEED_ADMIN_USERNAME=admin

# --- School settings --------------------------------------------------------
SEED_SCHOOL_NAME=مدرسة الروض الخاصة
SEED_CURRENCY=SYP
SEED_CURRENCY_SYMBOL=د.س
LOG_LEVEL=INFO

# --- Messaging safety (leave as-is until G0/G4) -----------------------------
# The stack is intentionally unable to send live SMS with these values.
MESSAGING_PROVIDER=fake
MESSAGING_ENABLED=false
MESSAGING_KILL_SWITCH=true
MESSAGING_RATE_LIMIT_PER_SECOND=1
MESSAGING_MAX_ATTEMPTS=3
MESSAGING_LEASE_SECONDS=60
MESSAGING_ALLOWLIST=
FAKE_PROVIDER_SCENARIO=delivered
# Only for an explicit production dry-run. Never enable for live delivery.
MESSAGING_ALLOW_FAKE_IN_PRODUCTION=false

# Assisted OCR for scanned PDFs. The API image/host must include Tesseract and
# the Arabic traineddata; otherwise imports degrade to SCANNED_PDF safely.
OCR_ENABLED=true
OCR_TESSERACT_CMD=tesseract
OCR_TESSDATA_DIR=
OCR_LANGUAGES=ara+eng
OCR_RENDER_DPI=300
OCR_MIN_CONFIDENCE=50

# Provider placeholders. Empty values are expected pre-G4.
RASEL_API_KEY=
RASEL_BASE_URL=https://raselsms.com
RASEL_CHANNEL=local_sms
RASEL_SENDER_ID=

# --- Backup job (read by systemd or the operator, not by Compose) -----------
# BACKUP_DIR=/var/backups/feedesk
# BACKUP_RETENTION_DAYS=30
# BACKUP_UPLOADS_VOLUME=feedesk_prod_uploads
# BACKUP_METRICS_TEXTFILE=/var/lib/node_exporter/textfile/feedesk_backup.prom
# Required for --execute: encrypt dumps with age. Keep the private key offline.
# BACKUP_AGE_RECIPIENT=age1replace-me
